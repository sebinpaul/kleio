# Used by docker compose for UI build args + UI runtime Clerk secret.
# API secrets stay in BE/.env (loaded via env_file).
# Copy: cp .env.example .env
#
# No domain yet — use your VM public IP (or localhost for local prod test).
# Example: SERVER_IP=203.0.113.10

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Must match how browsers reach the API/UI (rebuild UI if these change)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: worker watchdog → Healthchecks.io (see DEPLOYMENT.worker-watchdog.md)
# HEALTHCHECKS_PING_URL=https://hc-ping.com/YOUR-UUID
